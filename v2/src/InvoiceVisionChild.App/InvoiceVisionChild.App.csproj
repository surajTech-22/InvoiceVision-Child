<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>InvoiceVisionChild.App.App</StartupObject>
    <AssemblyName>InvoiceVisionChild</AssemblyName>
    <RootNamespace>InvoiceVisionChild.App</RootNamespace>
    <Version>2.8.2</Version>
    <AssemblyVersion>2.8.2.0</AssemblyVersion>
    <FileVersion>2.8.2.0</FileVersion>
    <Product>Invoice OCR Child</Product>
    <Title>InvoiceVision Child v2</Title>
    <Description>Local LightOnOCR-2-1B + Qwen3-VL-4B Indian GST invoice verification workspace for AAH</Description>
    <ApplicationIcon>Assets\InvoiceVisionChild.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceVisionChild.Contracts\InvoiceVisionChild.Contracts.csproj" />
    <ProjectReference Include="..\InvoiceVisionChild.Core\InvoiceVisionChild.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\InvoiceVisionChild.ico" />
    <Content Include="Assets\InvoiceVisionChild.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\InvoiceVisionChild.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\engine\*.py">
      <Link>Engine\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\agents_env\**\*" Exclude="..\..\agents_env\__pycache__\**;..\..\agents_env\.venv\**">
      <Link>AgentsEnv\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
